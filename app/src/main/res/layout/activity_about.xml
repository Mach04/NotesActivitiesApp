<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:focusableInTouchMode="true">
        <TextView android:id="@+id/screenTitle" style="@style/ScreenHeading" android:text="@string/about"  />
        <TextView android:id="@+id/aboutAppName" style="@style/BodyText" android:text="@string/app_name" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/author" style="@style/BodyText" android:text="@string/author" android:textColor="@color/accent" />
        <TextView android:id="@+id/aboutDescription" style="@style/BodyText" android:text="@string/about_description"  />
        <TextView android:id="@+id/memoryNotice" style="@style/BodyText" android:text="@string/memory_notice" android:textColor="@color/text_secondary" android:layout_marginBottom="24dp" />
        <Button android:id="@+id/backButton" style="@style/ActionButton" android:text="@string/back" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
